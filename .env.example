# =============================================================================
#  Presto global .env — loaded automatically by Docker Compose
#  Edit this file, then run presto_launch.sh > Build / Manage Stack
# =============================================================================

# ── Compose project name ─────────────────────────────────────────────────────
# Pinned so container/volume/network auto-naming is identical no matter what
# directory or path you clone presto into. Without this, Compose derives the
# project name from the checkout folder's basename, so "~/presto" vs
# "/opt/presto_v2" vs "~/dockerstackz" would silently get different implicit
# volume names for anything not explicitly named in service.yml.
COMPOSE_PROJECT_NAME=presto

# ── Host identity ─────────────────────────────────────────────────────────────
SYSTEM_HOSTNAME=your-hostname          # e.g. rpi5-nas
HOST_IP=192.168.1.x                    # LAN IP of this machine
REMOTE_HOSTNAME=your-remote-hostname   # optional, for multi-host setups
REMOTE_IP=192.168.1.x

# ── Container user (file permissions) ────────────────────────────────────────
# Auto-filled by presto with THIS machine's real uid/gid the first time
# .env is created — don't hardcode 1000:1000 here, since whoever clones the
# repo may not have uid 1000. Every linuxserver.io-style image (sonarr,
# radarr, jellyfin, qbittorrent, etc.) should read these two vars so files
# it writes into bind-mounted volumes stay owned by, and writable by, you —
# not root and not some other uid. Check `id -u` / `id -g` if you ever need
# to confirm these manually.
PUID=1000
PGID=1000

# ── Volume path (Compose context) ────────────────────────────────────────────
# Path prefix used in service.yml volume bind-mounts: ${VOLUMES_DIR}/<app>/...
#
# Presto default — relative to docker-compose.yml (i.e. $PRESTO_DIR/volumes):
VOLUMES_DIR=./volumes
#
# If your data lives elsewhere, use an absolute path:
# VOLUMES_DIR=/home/pi/presto/volumes        ← explicit absolute (same result)
# VOLUMES_DIR=/mnt/nas/docker/volumes        ← external drive / NFS mount
# VOLUMES_DIR=/home/user/dockerstackz/media  ← custom stack layout
#
# Note: also update PRESTO_VOLUMES_DIR in presto.conf to match, so presto's
# config-seeding scripts write to the same location.

# ── Timezone ──────────────────────────────────────────────────────────────────
# Auto-populated by presto from /etc/timezone on first deploy.
# Override here if you want a different zone for containers.
TZ=Europe/London



# OTHER ENV  FOR APPS EG IMMICH CAN GO HERE TO POPULATE PATHS TO MOUNTED DRIVE ETC


# [IMMICH] 
# The location where your uploaded files are stored
#UPLOAD_LOCATION=${VOLUMES_DIR}/immich/library

# The location where your database files are stored. Network shares are not supported for the database
#DB_DATA_LOCATION=${VOLUMES_DIR}/immich/data/postgres

# Compose needs this to pull the correct image tag
#IMMICH_VERSION=release


# [AdventureLog] 
#ADVENTURELOG_APP_PORT=8015
#ADVENTURELOG_SITE_URL=http://YOUR PI NAME:8015
#ADVENTURELOG_DB_NAME=database
#ADVENTURELOG_DB_USER=adventure
#ADVENTURELOG_DB_PASSWORD=your_secure_db_password




# [dawarich]
# Port & Network
#DAWARICH_APP_PORT=3000

# PostgreSQL Master Credentials (used by the dawarich_db container)
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=postgres
#POSTGRES_DB=dawarich_production

# Rails & Database Connection (used by app & sidekiq containers)
#RAILS_ENV=production
#DATABASE_HOST=dawarich_db
#DATABASE_PORT=5432
#DATABASE_USERNAME=postgres
#DATABASE_PASSWORD=postgres
#DATABASE_NAME=dawarich_production

# Core App Config
#SECRET_KEY_BASE=YOUR SECRET KEY HERE TO SETUP
#APPLICATION_HOSTS=localhost,127.0.0.1,rpi4-nas,192.168.1.81
#APPLICATION_PROTOCOL=http
#TIME_ZONE=Europe/London
#REDIS_URL=redis://dawarich_redis:6379
#ALLOW_REGISTRATION=true
# Concurrency & Performance
#WEB_CONCURRENCY=1
#BACKGROUND_PROCESSING_CONCURRENCY=2

# Limits & System (optional defaults)
#APP_CPU_LIMIT=0.50
#APP_MEMORY_LIMIT=4G
#LOG_MAX_SIZE=100m
#LOG_MAX_FILE=5

# User Mapping
#PUID=1000
#PGID=1000