#---------------------------------------------------------------------#
#  PRESTO v2 — Global Environment Configuration                       #
#---------------------------------------------------------------------#
#                                                                     #
#  HOW TO USE:                                                        #
#  1. This file is copied to .env automatically on first run          #
#  2. Edit .env with your own values:  nano .env                      #
#  3. DO NOT commit your .env to git — it contains your private settings   #
#  4. This file (.env.example) is safe to commit — no secrets here    #
#                                                                     #
#---------------------------------------------------------------------#
#---------------------------------------------------------------------#
# This is where all the apps data/configs all go to keep them  safe 
# across updates and re-deployments. You can change this if you want 
#---------------------------------------------------------------------#
VOLUMES_DIR="volumes"


#---------------------------------------------------------------------#
# SYSTEM — Primary Pi / host settings
# These are referenced by service.yml files across all services
#---------------------------------------------------------------------#
SYSTEM_HOSTNAME=your-hostname        
# eg. rpi5-nas
HOST_URL=${SYSTEM_HOSTNAME}.local    
# eg. rpi5-nas.local
HOST_IP=192.168.1.x                  
# eg. 192.168.1.100

# Secondary host (for users with a 2nd device for media/storage etc.)
# If not using a second device, leave these matching your primary above
REMOTE_HOSTNAME=your-remote-hostname
REMOTE_IP=192.168.1.x


#---------------------------------------------------------------------#
# TIMEZONE
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
#---------------------------------------------------------------------#
TZ=Europe/London

#---------------------------------------------------------------------#
# PHOTOPRISM
# Path to your external USB/media drive (check with: lsblk)
# PHOTOPRISM_MEDIA_PATH=/media/PRESTO_MEDIA_2TB
#---------------------------------------------------------------------#

#---------------------------------------------------------------------#
# IMMICH
# https://immich.app/docs/install/environment-variables
#---------------------------------------------------------------------#
UPLOAD_LOCATION=./${VOLUMES_DIR}/immich/library
DB_DATA_LOCATION=./${VOLUMES_DIR}/immich/data/postgres
IMMICH_VERSION=release
DB_PASSWORD=changeme_use_random_password
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
