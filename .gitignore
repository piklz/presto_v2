# =============================================================================
#  Presto .gitignore
# =============================================================================

# Generated by presto — never commit these
docker-compose.yml
services/

# User config — edit locally, don't commit
# (presto.conf.example is committed; presto.conf is yours)
presto.conf

# Update notification state
.update_notified
.outofdate

# OS noise
.DS_Store
Thumbs.db

# Editor cruft
*.swp
*.swo
*~
.vscode/
.idea/

# Temp files
*.tmp
*.bak
