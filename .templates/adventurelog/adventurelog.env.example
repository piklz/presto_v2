# ── Core Server Settings ─────────────────────────────────────
SITE_URL=http://CHANGEME!YOUR-PI-NAME-or-ip:8015
PORT=3000

# ── Database Credentials ─────────────────────────────────────
PGHOST=adventurelog_db
POSTGRES_DB=database
POSTGRES_USER=adventure
POSTGRES_PASSWORD=your_secure_db_password

# ── First-Boot Admin Credentials ──────────────────────────────
# (Used on initial run to automatically create your master account)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_PASSWORD=YourSecureAdminPassword123!
DJANGO_ADMIN_EMAIL=admin@example.com

# ── Feature Flags ─────────────────────────────────────────────
DISABLE_REGISTRATION=False

# ── User/Group Permissions ────────────────────────────────────
PUID=1000
PGID=1000