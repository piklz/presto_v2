TZ=Europe/London
PUID=1000
PGID=1000
# ./services/dawarich/dawarich.env (created from this on first deploy)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=dawarich_development

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=changeme_generate_a_long_random_string

# Comma-separated list of hosts (no http:// or ports)
APPLICATION_HOSTS=localhost,127.0.0.1,your-pi-hostname.local,your-pi-ip

DAWARICH_APP_PORT=3000
TIME_ZONE=Europe/London
APPLICATION_PROTOCOL=http
WEB_CONCURRENCY=1
BACKGROUND_PROCESSING_CONCURRENCY=2