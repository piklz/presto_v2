PUID=1000
PGID=1000
# PrestoBack environment — place at:
#   ~/presto/services/prestoback/prestoback.env
#
# This file is sourced by docker compose and is gitignored by presto.
# DO NOT commit real values.

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Europe/London

# ── Self-update ───────────────────────────────────────────────────────────────
# The exact image reference prestoback will pull when you click "Update now".
# Must match the image: line in your compose service entry.
PRESTOBACK_IMAGE=piklz/prestoback:latest

# Must match the container_name: in your compose service entry.
# The updater helper uses this to docker stop / rm / run the right container.
PRESTOBACK_CONTAINER=prestoback

# ── Optional: API key override ────────────────────────────────────────────────
# Leave blank to auto-generate on first start (key printed in container logs).
# Set this if you want a fixed key (e.g. for scripting or Telegram bot).
# PRESTOBACK_API_KEY=your-key-here