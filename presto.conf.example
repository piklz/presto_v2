#!/usr/bin/env bash
# =============================================================================
#  presto.conf.example — Presto bash-side configuration
#
#  Copy to presto.conf and edit.  Sourced by presto_launch.sh at startup.
#  presto.conf is gitignored — your values never end up in the repo.
# =============================================================================

# ── Docker network ────────────────────────────────────────────────────────────
PRESTO_NETWORK_NAME="private_network"
PRESTO_SUBNET="172.19.0.0/24"
# Common alternatives if 172.19 clashes: 172.20.0.0/24  10.10.0.0/24

# ── Compose file ──────────────────────────────────────────────────────────────
PRESTO_COMPOSE_FILE="$PRESTO_DIR/docker-compose.yml"

# ── Volumes directory (bash context) ─────────────────────────────────────────
# Where presto seeds config files and where your app data lives.
# Relative values are resolved against $PRESTO_DIR automatically, so
# "volumes" is equivalent to "$PRESTO_DIR/volumes" — both are fine.
#
# Keep this consistent with VOLUMES_DIR in your root .env (the Compose side).
#
PRESTO_VOLUMES_DIR="volumes"
#
# External drive / NFS / custom layout — use an absolute path:
# PRESTO_VOLUMES_DIR="/mnt/nas/docker/volumes"
# PRESTO_VOLUMES_DIR="/home/user/dockerstackz/media"

# ── Menu color theme ──────────────────────────────────────────────────────────
# Options: pink (default) | ocean | matrix | sunset | mono
# Change anytime via System Tools → 🎨 Change theme — that also updates this
# line automatically, this default just covers a fresh install.
PRESTO_THEME="pink"
